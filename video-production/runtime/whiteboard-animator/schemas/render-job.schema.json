{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-media/contracts/whiteboard-animator-job-1.3.json",
  "title": "AI-media Whiteboard Animator Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "adapter_id", "job_id", "revision_id", "source", "output", "output_spec", "timing"],
  "properties": {
    "contract_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]},
    "adapter_id": {"const": "whiteboard_animator"},
    "render_route": {"enum": ["auto", "flat_auto", "structured_semantic"]},
    "job_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "rights_evidence"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "rights_evidence": {"type": "string", "minLength": 1}, "supersample_scale": {"enum": [1, 4]}}
    },
    "output": {"type": "string", "minLength": 1},
    "output_spec": {
      "type": "object", "additionalProperties": false, "required": ["width_px", "height_px", "pixel_format", "native_audio"],
      "properties": {"width_px": {"type": "integer", "minimum": 2, "multipleOf": 2}, "height_px": {"type": "integer", "minimum": 2, "multipleOf": 2}, "pixel_format": {"const": "yuv420p"}, "native_audio": {"const": "none"}}
    },
    "timing": {
      "type": "object", "additionalProperties": false, "required": ["total_duration_seconds", "fps"],
      "properties": {"policy": {"enum": ["auto", "manual"]}, "pace": {"enum": ["calm", "normal", "energetic"]}, "total_duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "draw_duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "fps": {"type": "integer", "minimum": 1}}
    },
    "structured_layers": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "background", "line_art", "objects"],
          "properties": {
            "mode": {"const": "prepainted_background_object_reveal"},
            "background": {"$ref": "#/$defs/imageAsset"},
            "line_art": {"$ref": "#/$defs/imageAsset"},
            "line_art_threshold": {"type": "integer", "minimum": 1, "maximum": 254},
            "objects": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "order", "mask", "stroke_duration_seconds", "fill_duration_seconds"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "order": {"type": "integer", "minimum": 0},
              "mask": {"$ref": "#/$defs/imageAsset"},
              "stroke_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
              "fill_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "paper_rgb", "layers"],
          "properties": {
            "mode": {"const": "stacked_layer_object_complete_reveal"},
            "paper_rgb": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}], "minItems": 3, "maxItems": 3},
            "line_alpha_tolerance_px": {"type": "integer", "minimum": 1, "maximum": 16},
            "layers": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "draw_order", "z_index", "reveal_mode", "color_rgba"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "draw_order": {"type": "integer", "minimum": 0},
                  "z_index": {"type": "integer", "minimum": 0},
                  "reveal_mode": {"enum": ["line_then_fill", "direct_fill"]},
                  "semantic_kind": {"enum": ["geometry", "text", "illustration", "shadow"]},
                  "text_regions": {"type": "array", "items": {"$ref": "#/$defs/textRegion"}},
                  "color_rgba": {"$ref": "#/$defs/imageAsset"},
                  "line_art_rgba": {"$ref": "#/$defs/imageAsset"},
                  "stroke_duration_seconds": {"type": "number", "minimum": 0},
                  "fill_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        }
      ]
    },
    "source_plan": {
      "type": "object", "additionalProperties": false,
      "properties": {"palette_limit": {"type": "integer", "minimum": 1, "maximum": 32}}
    },
    "segment_window": {
      "type": "object", "additionalProperties": false,
      "required": ["start_frame", "end_frame_exclusive", "logical_total_frames", "boundary_mode", "hide_tip_on_first_frame"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "logical_total_frames": {"type": "integer", "minimum": 1},
        "boundary_mode": {"enum": ["continuous_canvas", "board_cut"]},
        "hide_tip_on_first_frame": {"type": "boolean"}
      }
    },
    "tip_overlay": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "rights_evidence", "tip_anchor", "height_fraction"],
      "properties": {
        "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "rights_evidence": {"type": "string", "minLength": 1},
        "tip_anchor": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 2, "maxItems": 2},
        "height_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "max_continuous_step_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "encoding": {"type": "object"}
  },
  "$defs": {
    "imageAsset": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "rights_evidence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "rights_evidence": {"type": "string", "minLength": 1}
      }
    },
    "textRegion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "bbox", "line_order", "reading_order", "direction", "glyph_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "bbox": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "minItems": 4, "maxItems": 4},
        "line_order": {"type": "integer", "minimum": 0},
        "reading_order": {"type": "integer", "minimum": 0},
        "direction": {"const": "left_to_right"},
        "glyph_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
